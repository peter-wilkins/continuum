{
  "name": "@continuum/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "smoke:core": "tsx src/coreSmoke.ts",
    "smoke:local-source-cache": "tsx src/localSourceCacheSmoke.ts",
    "smoke:public-continuum": "tsx src/publicContinuumSmoke.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@continuum/shared": "0.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.0.0",
    "@supabase/supabase-js": "^2.49.8",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "openai": "^6.38.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
